generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id    String   @id @default(uuid()) @db.Uuid
  fullName  String   @db.VarChar(255)
  email  String   @unique @db.VarChar(255)
  description String?  @db.Text
  password String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  // Workspace ownership
  ownedWorkspaces workspaces[] @relation("WorkspaceOwner")
  // Memberships
  workspaceMembers workspacemembers[]
  projectMembers   projectmembers[]
  // Project creation
  createdProjects projects[] @relation("ProjectCreator")
  // Board creation
  createdBoards boards[] @relation("BoardCreator")
  // Task assignment and creation
  assignedTasks tasks[] @relation("TaskAssignee")
  createdTasks  tasks[] @relation("TaskCreator")
  // Added project members
  addedProjectMembers projectmembers[] @relation("ProjectMemberAdder")
  sentWorkspaceInvites workspaceinvites[] @relation("WorkspaceInviteSender")
  receivedWorkspaceInvites workspaceinvites[] @relation("WorkspaceInviteReceiver")
}

model workspaces {
  id   String   @id @default(uuid()) @db.Uuid
  name  String   @db.VarChar(255)
  description String?  @db.Text
  ownerId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  owner users @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  workspaceMembers workspacemembers[]
  workspaceInvites workspaceinvites[] 
  projects  projects[]
  @@index([ownerId])
  @@index([deletedAt])
}

enum role {
  member
  owner
}
model workspacemembers {
  id  String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())
  role role @default(member)
  workspace workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}
enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model workspaceinvites {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  invitedBy   String       @db.Uuid
  invitedUser String       @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter users @relation("WorkspaceInviteSender",fields: [invitedBy],references: [id])
  user users @relation("WorkspaceInviteReceiver",fields: [invitedUser],references: [id])

  @@unique([workspaceId, invitedUser])
  @@index([workspaceId])
}

model projects {
  id   String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name   String   @db.VarChar(255)
  description String?  @db.Text
  deadline  DateTime?
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? 
  workspace workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   users      @relation("ProjectCreator", fields: [createdBy], references: [id])
  projectMembers projectmembers[]
  boards         boards[]
  @@unique([workspaceId, name])
}

model projectmembers {
  id  String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid 
  userId  String   @db.Uuid
  addedBy  String   @db.Uuid
  joinedAt DateTime @default(now())
  role role @default(member)
  deletedAt DateTime?
  project     projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedByUser users    @relation("ProjectMemberAdder", fields: [addedBy], references: [id])
  @@unique([projectId, userId,deletedAt])
}

model boards {
  id    String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name  String   @db.VarChar(255)
  description String?  @db.Text
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  project projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator users    @relation("BoardCreator", fields: [createdBy], references: [id])
  tasks   tasks[] 
  @@unique([projectId, name])
  @@index([projectId])
}
model tasks {
  id  String   @id @default(uuid()) @db.Uuid
  boardId     String   @db.Uuid
  title   String   @db.VarChar(255)
  description String?    @db.Text
  assignedTo  String?    @db.Uuid
  createdBy  String     @db.Uuid
  status     status     @default(TODO)
  position  Int  @default(0)
  deadline DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  board boards @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee users? @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator  users  @relation("TaskCreator", fields: [createdBy], references: [id])
  @@unique([boardId, status, position])
  @@index([boardId])
}
enum status {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}
